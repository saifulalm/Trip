<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand">
      <img src="/img/logo.svg" alt="Logo <%= settings.siteName || 'jalanjalanenak' %>">
      <span class="brand__text">
        <span class="brand__name">jalanjalan<span>enak</span>.com</span>
        <span class="brand__tag">Wisata Bahari Nusantara</span>
      </span>
    </a>
    <button class="nav-toggle" aria-label="Buka menu"><span></span><span></span><span></span></button>
    <nav class="nav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Beranda</a>
      <a href="/destinasi" class="<%= currentPath.startsWith('/destinasi') ? 'active' : '' %>">Destinasi</a>
      <a href="/paket" class="<%= currentPath.startsWith('/paket') ? 'active' : '' %>">Paket Wisata</a>
      <a href="/artikel" class="<%= currentPath.startsWith('/artikel') ? 'active' : '' %>">Artikel</a>
      <a href="/tentang" class="<%= currentPath === '/tentang' ? 'active' : '' %>">Tentang</a>
      <a href="/kontak" class="<%= currentPath === '/kontak' ? 'active' : '' %>">Kontak</a>
      <% if (currentCustomer) { %>
        <a href="/akun" class="<%= currentPath.startsWith('/akun') ? 'active' : '' %>">👤 <%= currentCustomer.name.split(' ')[0] %></a>
      <% } else { %>
        <a href="/masuk" class="<%= currentPath === '/masuk' || currentPath === '/daftar' ? 'active' : '' %>">Masuk</a>
      <% } %>
      <a href="/paket" class="btn btn--sunset btn--sm">Pesan Sekarang</a>
    </nav>
  </div>
</header>