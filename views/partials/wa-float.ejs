<% /* Menu WhatsApp mengambang — nomor & pesan dari Pengaturan Situs.
   -
   - Widget ini dibuat lebih "animatif":
   -   1. Cincin denyut pada tombol (menarik perhatian tanpa mengganggu).
   -   2. Panel menu muncul dengan animasi stagger per item.
   -   3. Tombol berubah jadi "tutup" (X) saat panel terbuka.
   -   4. Tombol "ke atas" muncul setelah halaman digulir, untukPSI
   -      visitors kembali ke section teratas dengan mulus.
   */ %>
<% if (settings.waFloatEnabled !== false && settings.whatsapp) { %>
<div class="wa-float" id="waFloat">
  <div class="wa-float__panel" id="waFloatPanel" hidden>
    <p class="wa-float__head">
      <span class="wa-float__head-icon" aria-hidden="true">👋</span>
      Butuh bantuan? Chat kami
    </p>
    <a
      class="wa-float__item"
      href="https://wa.me/<%= settings.whatsapp %>?text=<%= encodeURIComponent(settings.waFloatMessage || 'Halo! Saya mau tanya-tanya soal trip ya.') %>"
      target="_blank"
      rel="noopener"
    ><span class="wa-float__item-icon" aria-hidden="true">💬</span><span>Tanya Trip &amp; Harga</span></a>
    <a
      class="wa-float__item"
      href="https://wa.me/<%= settings.whatsapp %>?text=<%= encodeURIComponent('Halo, saya mau konsultasi soal paket wisata yang cocok untuk saya.') %>"
      target="_blank"
      rel="noopener"
    ><span class="wa-float__item-icon" aria-hidden="true">🏝️</span><span>Konsultasi Paket</span></a>
    <a
      class="wa-float__item"
      href="https://wa.me/<%= settings.whatsapp %>?text=<%= encodeURIComponent('Halo, saya butuh bantuan terkait booking saya.') %>"
      target="_blank"
      rel="noopener"
    ><span class="wa-float__item-icon" aria-hidden="true">🎫</span><span>Bantuan Booking</span></a>
  </div>

  <!-- Baris aksi: tombol "ke atas" di KIRI tombol WhatsApp, keduanya
       sejajar horizontal. Susunan ini mencegah tumpang tindih dengan
       tombol audio hero yang juga berada di sisi kanan bawah layar. -->
  <div class="wa-float__actions">
  <button type="button" class="wa-float__top" id="waTopBtn" aria-label="Kembali ke atas halaman">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V6M6 11l6-6 6 6"></path>
    </svg>
  </button>

  <button type="button" class="wa-float__btn" id="waFloatBtn" aria-label="Buka menu WhatsApp" aria-expanded="false">
    <!-- Cincin denyut (purel CSS, dimatikan saat panel terbuka). -->
    <span class="wa-float__pulse" aria-hidden="true"></span>
    <span class="wa-float__glyph" aria-hidden="true">
      <svg class="wa-float__ico-wa" viewBox="0 0 32 32" width="26" height="26" fill="currentColor">
        <path d="M16.04 3C9.06 3 3.4 8.66 3.4 15.64c0 2.23.58 4.4 1.7 6.32L3 29.5l7.72-2.03a12.6 12.6 0 0 0 5.32 1.2h.01c6.98 0 12.64-5.66 12.64-12.64C28.69 8.66 23.02 3 16.04 3zm0 23.06h-.01c-1.66 0-3.29-.45-4.71-1.29l-.34-.2-3.61.95.96-3.52-.22-.36a10.28 10.28 0 0 1-1.58-5.47c0-5.7 4.64-10.33 10.35-10.33 2.76 0 5.36 1.08 7.31 3.03a10.27 10.27 0 0 1 3.03 7.31c0 5.7-4.64 10.33-10.33 10.33zm5.67-7.73c-.31-.16-1.84-.91-2.13-1.01-.29-.1-.5-.16-.71.16-.21.31-.81 1.01-1 1.22-.19.21-.37.24-.68.08-.31-.16-1.31-.48-2.5-1.54-.92-.83-1.55-1.85-1.73-2.16-.18-.31-.02-.48.14-.64.14-.14.31-.37.47-.55.16-.19.21-.31.31-.52.1-.21.05-.39-.03-.55-.08-.16-.71-1.72-.98-2.35-.26-.62-.52-.54-.71-.55l-.61-.01c-.21 0-.55.08-.84.39-.29.31-1.1 1.08-1.1 2.63s1.13 3.05 1.29 3.26c.16.21 2.22 3.4 5.39 4.77.75.33 1.34.52 1.8.67.76.24 1.45.2 2 .12.61-.09 1.84-.75 2.1-1.48.26-.73.26-1.35.18-1.48-.08-.13-.29-.21-.6-.37z"/>
      </svg>
      <svg class="wa-float__ico-close" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </span>
  </button>
  </div>
</div>
<script>
  (function () {
    var btn = document.getElementById('waFloatBtn');
    var panel = document.getElementById('waFloatPanel');
    var topBtn = document.getElementById('waTopBtn');
    if (!btn || !panel) return;

    /* ---------- Buka / tutup panel ---------- */
    function setOpen(open) {
      if (open) {
        panel.removeAttribute('hidden');
        // Paksa reflow supaya transisi & animasi stagger berjalan.
        void panel.offsetWidth;
        panel.classList.add('is-open');
        btn.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', 'Tutup menu WhatsApp');
      } else {
        panel.classList.remove('is-open');
        btn.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Buka menu WhatsApp');
        // Tunggu animasi keluar selesai baru sembunyikan dari alur tab.
        window.setTimeout(function () {
          if (!panel.classList.contains('is-open')) panel.setAttribute('hidden', '');
        }, 220);
      }
      // Koordinasi dengan tombol audio hero: panel WhatsApp membuka ke atas
      // dan menutupi area tempat tombol audio berada (keduanya fixed di
      // pojok kanan bawah). Sembunyikan audio selama panel terbuka supaya
      // keduanya tidak pernah tumpang tindih.
      document.body.classList.toggle('is-wa-panel-open', open);
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      setOpen(panel.hasAttribute('hidden'));
    });

    document.addEventListener('click', function (e) {
      if (!e.target.closest('#waFloat')) setOpen(false);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') setOpen(false);
    });

    /* ---------- Tombol "kembali ke atas" ---------- */
    if (topBtn) {
      var ticking = false;
      function updateTop() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () {
          ticking = false;
          // Muncul setelah 480px — cukup jauh agar tidak mengganggu
          // pembaca yang baru mulai membaca hero.
          topBtn.classList.toggle('is-visible', window.scrollY > 480);
        });
      }
      window.addEventListener('scroll', updateTop, { passive: true });
      updateTop();

      topBtn.addEventListener('click', function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        // Kembalikan fokus ke navigasi utama agar pengguna tidak
        // kehilangan posisi dalam alur keyboard.
        var brand = document.querySelector('.site-header .brand');
        if (brand) brand.focus({ preventScroll: true });
      });
    }
  })();
</script>
<% } %>
