      <g id="i-mail"><rect x="2.5" y="5" width="17" height="12" rx="2"/><path d="M3 6.5l7.5 5.5 7.5-5.5"/></g>
      <g id="i-star"><path d="M11 3.2l2.4 5.1 5.6.7-4.1 3.9 1.1 5.5-5-2.8-5 2.8 1.1-5.5L3 9l5.6-.7z"/></g>
