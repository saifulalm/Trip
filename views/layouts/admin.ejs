  <script>
    /* ---------- Pratinjau langsung warna aksen ---------- */
    (function () {
      var picker = document.getElementById('themeAccentPicker');
      var valueEl = document.getElementById('themeAccentValue');
      if (!picker) return;

      /** Ubah hex menjadi komponen RGB. */
      function toRgb(hex) {
        var clean = String(hex || '').replace('#', '');
        if (clean.length === 3) clean = clean.split('').map(function (c) { return c + c; }).join('');
        var n = parseInt(clean, 16);
        return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
      }

      /** Campur warna dengan putih/black untuk membuat turunan. */
      function mix(c, target, amount) {
        return 'rgb(' + Math.round(c.r + (target.r - c.r) * amount) + ', ' +
          Math.round(c.g + (target.g - c.g) * amount) + ', ' +
          Math.round(c.b + (target.b - c.b) * amount) + ')';
      }

      function applyPreview(hex) {
        var c = toRgb(hex);
        var root = document.documentElement;
        root.style.setProperty('--accent', hex);
        root.style.setProperty('--accent-strong', mix(c, { r: 0, g: 0, b: 0 }, 0.22));
        root.style.setProperty('--accent-deep', mix(c, { r: 0, g: 0, b: 0 }, 0.42));
        root.style.setProperty('--accent-darkest', mix(c, { r: 0, g: 0, b: 0 }, 0.58));
        root.style.setProperty('--accent-soft', mix(c, { r: 255, g: 255, b: 255 }, 0.78));
        root.style.setProperty('--accent-glow', 'rgba(' + c.r + ', ' + c.g + ', ' + c.b + ', 0.22)');
        root.style.setProperty('--accent-line', 'rgba(' + c.r + ', ' + c.g + ', ' + c.b + ', 0.38)');
        if (valueEl) valueEl.textContent = hex;
      }

      picker.addEventListener('input', function () { applyPreview(picker.value); });
    })();
  </script>
  <script>
    (function () {
      var root = document.documentElement;
      var sidebar = document.getElementById('adminSidebar');
      var overlay = document.getElementById('adminSidebarOverlay');
      var menuBtn = document.getElementById('adminMenuBtn');

      /* ---------- Sidebar mobile ---------- */
      function isMobile() { return window.matchMedia('(max-width: 900px)').matches; }
      function setSidebar(open) {
        if (!sidebar) return;
        sidebar.classList.toggle('open', open);
        if (overlay) overlay.classList.toggle('open', open);
        document.body.style.overflow = open && isMobile() ? 'hidden' : '';
        if (menuBtn) menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      if (menuBtn) {
        menuBtn.addEventListener('click', function () {
          setSidebar(!sidebar.classList.contains('open'));
        });
      }
      if (overlay) overlay.addEventListener('click', function () { setSidebar(false); });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') setSidebar(false);
      });
      // Tutup sidebar setelah navigasi di layar kecil
      document.querySelectorAll('.admin-nav a').forEach(function (a) {
        a.addEventListener('click', function () { if (isMobile()) setSidebar(false); });
      });
      window.addEventListener('resize', function () {
        if (!isMobile()) setSidebar(false);
      });

      /* ---------- Tema terang/gelap ---------- */
      var toggle = document.getElementById('themeToggle');
      var OVERRIDE_KEY = 'syl-admin-theme-override';
      var baseMode = '<%= themeMode %>';

      // Terapkan mode ke elemen <html>.
      // `persist` menentukan apakah pilihan ini disimpan sebagai override lokal.
      function applyTheme(mode, persist) {
        var dark = mode === 'dark' ||
          (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.setAttribute('data-theme', dark ? 'dark' : 'light');
        if (persist) {
          try { localStorage.setItem(OVERRIDE_KEY, mode); } catch (err) {}
        }
      }

      // Mode dasar berasal dari Pengaturan (sumber kebenaran admin).
      // Override lokal hanya dipakai bila admin memakai tombol tema di topbar.
      var override = null;
      try { override = localStorage.getItem(OVERRIDE_KEY); } catch (err) {}
      applyTheme(override || baseMode, false);

      if (toggle) {
        toggle.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          applyTheme(next, true);
        });
      }

      // Ikuti perubahan preferensi sistem bila mode = auto.
      var mq = window.matchMedia('(prefers-color-scheme: dark)');
      var onChange = function () {
        var mode = override || baseMode;
        try { mode = localStorage.getItem(OVERRIDE_KEY) || mode; } catch (err) {}
        if (mode === 'auto') applyTheme('auto', false);
      };
      if (mq.addEventListener) mq.addEventListener('change', onChange);
      else if (mq.addListener) mq.addListener(onChange);
    })();
  </script>
  <% if (typeof mapData !== 'undefined' && mapData) { %>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script src="/js/map.js"></script>
  <% } %>
</body>
</html>
