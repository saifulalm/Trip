<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% const ogTitle = (seo && seo.title) ? seo.title : title; %>
  <% const ogDesc = (seo && seo.description) ? seo.description : (settings.tagline || 'Liburan pulau yang enak, terencana, tanpa ribet'); %>
  <% const ogImage = (seo && seo.image) ? seo.image : (settings.ogImageUrl || settings.heroImageUrl || '/img/dest-sabesi.svg'); %>
  <% const ogType = (seo && seo.type) ? seo.type : 'website'; %>
  <% const canonical = absoluteUrl(currentPath); %>
  <title><%= ogTitle %> · <%= settings.siteName || brand.domain %></title>
  <meta name="description" content="<%= ogDesc %>">
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
  <% if (settings.seoIndex === false) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <!-- Open Graph -->
  <meta property="og:site_name" content="<%= settings.siteName %>">
  <meta property="og:type" content="<%= ogType %>">
  <meta property="og:title" content="<%= ogTitle %>">
  <meta property="og:description" content="<%= ogDesc %>">
  <% if (canonical) { %><meta property="og:url" content="<%= canonical %>"><% } %>
  <% if (ogImage) { %><meta property="og:image" content="<%= absoluteUrl(ogImage) %>"><% } %>
  <meta property="og:locale" content="id_ID">
  <!-- Twitter Card -->
  <meta name="twitter:card" content="<%= ogImage ? 'summary_large_image' : 'summary' %>">
  <meta name="twitter:title" content="<%= ogTitle %>">
  <meta name="twitter:description" content="<%= ogDesc %>">
  <% if (ogImage) { %><meta name="twitter:image" content="<%= absoluteUrl(ogImage) %>"><% } %>
  <% const jsonLdItems = (seo && seo.jsonLd && seo.jsonLd.length)
    ? [{ '@context': 'https://schema.org', '@graph': seo.jsonLd }]
    : []; %>
  <% jsonLdItems.forEach((ld) => { %>
  <script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script>
  <% }); %>
  <link rel="icon" type="image/svg+xml" href="/img/logo.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=Karla:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&family=Great+Vibes&family=Dancing+Script:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/splash.css">
  <link rel="stylesheet" href="/css/ux.css">
  <% if (typeof mapData !== 'undefined' && mapData) { %>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  <% } %>
  <%# Script inline di <head> (sebelum body diparse): pasang layer splash
      secepat mungkin supaya situs tidak pernah "terlihat" sebelum splash.
      - Kalau user sudah pernah melihat splash di sesi ini, jangan sentuh apa pun
        → halaman langsung tampil tanpa kedipan.
      - Jaring pengaman 6 detik: bila /js/splash.js gagal dimuat, kelas dilepas
        dan situs tetap bisa dibuka. %>
  <script>
    (function () {
      var KEY = 'syt_splash_seen';
      var seen = false;
      try { seen = sessionStorage.getItem(KEY) === '1'; } catch (e) { seen = false; }
      if (seen) return;
      var root = document.documentElement;
      root.classList.add('syt-splash-pending', 'splash-active');
      window.setTimeout(function () {
        root.classList.remove('syt-splash-pending', 'splash-active');
        var s = document.getElementById('splash');
        if (s && s.parentNode) s.parentNode.removeChild(s);
        var b = document.getElementById('splashSkip');
        if (b && b.parentNode) b.parentNode.removeChild(b);
      }, 6000);
    })();
  </script>
</head>
<body>
  <%- include('../partials/splash') %>
  <%- include('../partials/flash') %>
  <%- include('../partials/header') %>
  <main>
    <%- body %>
  </main>
  <%- include('../partials/footer') %>
  <%- include('../partials/wa-float') %>
  <script>
    document.querySelector('.nav-toggle')?.addEventListener('click', function () {
      document.querySelector('.nav')?.classList.toggle('open');
    });
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
  <script src="/js/depth.js" defer></script>
  <script src="/js/splash.js" defer></script>
  <% if (typeof mapData !== 'undefined' && mapData) { %>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script src="/js/map.js"></script>
  <% } %>
</body>
</html>