<div class="panel">
  <div class="panel__head">
    <h2>Kotak Pesan (<%= pg.total %>)</h2>
  </div>
  <form class="table-toolbar" data-live-search action="/admin/pesan" method="get">
    <div class="search-box">
      <input type="search" name="q" value="<%= q %>" placeholder="Cari nama, email, subjek, atau isi pesan…" autocomplete="off">
    </div>
    <select name="status">
      <option value="">Semua</option>
      <option value="unread" <%= status === 'unread' ? 'selected' : '' %>>Belum dibaca</option>
      <option value="read" <%= status === 'read' ? 'selected' : '' %>>Sudah dibaca</option>
    </select>
    <button type="submit" class="btn-a btn-a--ghost btn-a--sm">Filter</button>
    <span class="search-meta" data-search-meta><%= pg.total %> pesan</span>
  </form>
  <div class="table-region" data-partial-url="/admin/pesan">
    <%- include('partials/list-messages', { rows: pg.rows, pg, q, status, sort, dir }) %>
  </div>
</div>
