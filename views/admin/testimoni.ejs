<div class="panel">
  <div class="panel__head">
    <h2>Testimoni &amp; Ulasan (<%= pg.total %>)</h2>
  </div>
  <form class="table-toolbar" data-live-search action="/admin/testimoni" method="get">
    <div class="search-box">
      <input type="search" name="q" value="<%= q %>" placeholder="Cari nama tamu, paket, kode booking, atau isi ulasan…" autocomplete="off">
    </div>
    <select name="status">
      <option value="">Semua status</option>
      <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Menunggu moderasi</option>
      <option value="approved" <%= status === 'approved' ? 'selected' : '' %>>Disetujui (tampil di beranda)</option>
      <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>Ditolak</option>
    </select>
    <button type="submit" class="btn-a btn-a--ghost btn-a--sm">Filter</button>
    <span class="search-meta" data-search-meta><%= pg.total %> ulasan</span>
  </form>
  <div class="table-region" data-partial-url="/admin/testimoni">
    <%- include('partials/list-reviews', { rows: pg.rows, pg, q, status, sort, dir }) %>
  </div>
</div>
