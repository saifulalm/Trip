<div class="panel">
  <div class="panel__head">
    <h2>Daftar Destinasi (<%= pg.total %>)</h2>
    <a href="/admin/destinasi/baru" class="btn-a btn-a--sunset">+ Tambah Destinasi</a>
  </div>
  <form class="table-toolbar" data-live-search action="/admin/destinasi" method="get">
    <div class="search-box">
      <input type="search" name="q" value="<%= q %>" placeholder="Cari nama, region, harga, status, atau koordinat…" autocomplete="off">
    </div>
    <button type="submit" class="btn-a btn-a--ghost btn-a--sm">Cari</button>
    <span class="search-meta" data-search-meta><%= pg.total %> destinasi</span>
  </form>
  <div class="table-region" data-partial-url="/admin/destinasi">
    <%- include('partials/list-destinations', { rows: pg.rows, pg, q, status, sort, dir }) %>
  </div>
</div>
