<div class="panel">
  <div class="panel__head">
    <h2>Daftar Destinasi (<%= pg.total %>)</h2>
    <a href="/admin/destinasi/baru" class="btn-a btn-a--sunset">+ Tambah Destinasi</a>
  </div>
  <form class="filter-bar" action="/admin/destinasi" method="get">
    <input type="search" name="q" value="<%= q %>" placeholder="Cari nama atau region…">
    <button type="submit" class="btn-a btn-a--ghost btn-a--sm">Cari</button>
  </form>
  <% if (pg.rows.length === 0) { %>
    <p style="color:var(--a-soft)">Belum ada destinasi.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="a-table">
        <thead>
          <tr><th>Gambar</th><th>Nama</th><th>Region</th><th>Harga Mulai</th><th>Status</th><th>Unggulan</th><th>Aksi</th></tr>
        </thead>
        <tbody>
          <% pg.rows.forEach(function (d) { %>
            <tr>
              <td><img src="<%= d.image %>" alt="" class="img-preview" style="width:72px;height:46px"></td>
              <td><strong><%= d.name %></strong><br><small style="color:var(--a-soft)">/<%= d.slug %></small></td>
              <td><%= d.region %></td>
              <td><%= formatRupiah(d.priceFrom) %></td>
              <td><span class="badge badge--<%= publicationStatusTone(d.status) %>"><%= publicationStatusLabel(d.status) %></span></td>
              <td><%= d.featured ? '⭐ Ya' : '—' %></td>
              <td>
                <div class="actions">
                  <a href="/destinasi/<%= d.slug %>" target="_blank" rel="noopener" class="btn-a btn-a--ghost btn-a--sm">Lihat</a>
                  <a href="/admin/destinasi/<%= d.id %>/edit" class="btn-a btn-a--primary btn-a--sm">Edit</a>
                  <form action="/admin/destinasi/<%= d.id %>/hapus" method="post" onsubmit="return confirm('Hapus destinasi <%= d.name %>?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-a btn-a--danger btn-a--sm">Hapus</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('partials/pagination', { pg: pg, q: q }) %>
  <% } %>
</div>