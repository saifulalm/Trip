<div class="panel">
  <div class="panel__head">
    <h2>Pelanggan Terdaftar (<%= pg.total %>)</h2>
  </div>
  <form class="table-toolbar" data-live-search action="/admin/pelanggan" method="get">
    <div class="search-box">
      <input type="search" name="q" value="<%= q %>" placeholder="Cari nama, email, nomor HP, atau kode booking…" autocomplete="off">
    </div>
    <button type="submit" class="btn-a btn-a--ghost btn-a--sm">Cari</button>
    <span class="search-meta" data-search-meta><%= pg.total %> pelanggan</span>
  </form>
  <div class="table-region" data-partial-url="/admin/pelanggan">
    <%- include('partials/list-customers', { rows: pg.rows, pg, q, status, sort, dir }) %>
  </div>
</div>
