<div class="panel">
  <div class="panel__head">
    <h2>Daftar Paket Wisata (<%= pg.total %>)</h2>
    <a href="/admin/paket/baru" class="btn-a btn-a--sunset">+ Tambah Paket</a>
  </div>
  <form class="table-toolbar" data-live-search action="/admin/paket" method="get">
    <div class="search-box">
      <input type="search" name="q" value="<%= q %>" placeholder="Cari judul, destinasi, durasi, harga, atau status…" autocomplete="off">
    </div>
    <button type="submit" class="btn-a btn-a--ghost btn-a--sm">Cari</button>
    <span class="search-meta" data-search-meta><%= pg.total %> paket</span>
  </form>
  <div class="table-region" data-partial-url="/admin/paket">
    <%- include('partials/list-packages', { rows: pg.rows, pg, q, status, sort, dir }) %>
  </div>
</div>
