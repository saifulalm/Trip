<div class="admin-head">
  <div>
    <h1>Kontak Marketing</h1>
    <p><%= contacts.length %> kontak terdaftar · <strong><%= marketable %></strong> siap menerima blast (opt-in &amp; bukan opt-out)</p>
  </div>
  <div class="admin-head__actions">
    <% if (!waActive) { %><span class="badge badge--cancelled">WA Cloud API belum aktif</span><% } %>
    <% if (quietHour) { %><span class="badge badge--pending">Jam tenang (21.00–08.00)</span><% } %>
    <a href="/admin/marketing/blast" class="btn-a btn-a--sunset">📣 Buat Blast</a>
  </div>
</div>

<div class="panel" style="margin-bottom:1.4rem">
  <div class="panel__head"><h2>Tambah Kontak Manual</h2></div>
  <form action="/admin/marketing/kontak" method="post" class="a-form" style="display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:0.8rem; align-items:end">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="a-field" style="margin:0"><label>Nama</label><input type="text" name="name" required></div>
    <div class="a-field" style="margin:0"><label>WhatsApp</label><input type="text" name="phone" placeholder="0812xxxx / 62812…" required></div>
    <div class="a-field" style="margin:0"><label>Email (opsional)</label><input type="email" name="email"></div>
    <label class="a-check" style="margin:0 0 0.4rem"><input type="checkbox" name="optIn"> Sudah minta izin promo</label>
    <button type="submit" class="btn-a btn-a--primary">Tambah</button>
  </form>
</div>

<div class="panel">
  <div class="panel__head">
    <h2>Daftar Kontak (<%= pg.total %>)</h2>
  </div>
  <form class="table-toolbar" data-live-search action="/admin/marketing/kontak" method="get">
    <div class="search-box">
      <input type="search" name="q" value="<%= q %>" placeholder="Cari nama, nomor WhatsApp, email, atau sumber…" autocomplete="off">
    </div>
    <button type="submit" class="btn-a btn-a--ghost btn-a--sm">Cari</button>
    <span class="search-meta" data-search-meta><%= pg.total %> kontak</span>
  </form>
  <div class="table-region" data-partial-url="/admin/marketing/kontak">
    <%- include('partials/list-contacts', { rows: pg.rows, pg, q, status, sort, dir }) %>
  </div>
</div>