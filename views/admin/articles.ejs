<div class="panel">
  <div class="panel__head">
    <h2>Daftar Artikel (<%= pg.total %>)</h2>
    <a href="/admin/artikel/baru" class="btn-a btn-a--sunset">+ Tulis Artikel</a>
  </div>
  <form class="table-toolbar" data-live-search action="/admin/artikel" method="get">
    <div class="search-box">
      <input type="search" name="q" value="<%= q %>" placeholder="Cari judul, kategori, penulis, atau status…" autocomplete="off">
    </div>
    <button type="submit" class="btn-a btn-a--ghost btn-a--sm">Cari</button>
    <span class="search-meta" data-search-meta><%= pg.total %> artikel</span>
  </form>
  <div class="table-region" data-partial-url="/admin/artikel">
    <%- include('partials/list-articles', { rows: pg.rows, pg, q, status, sort, dir }) %>
  </div>
</div>
