<%# Tabel Artikel %>
<% if (!rows || rows.length === 0) { %>
  <p class="no-results">Tidak ada artikel yang cocok dengan pencarian ini.</p>
<% } else { %>
  <div class="table-wrap">
    <table class="a-table">
      <thead>
        <tr>
          <%- include('th', { label: 'Judul', field: 'title', sort, dir }) %>
          <%- include('th', { label: 'Kategori', field: 'category', sort, dir }) %>
          <%- include('th', { label: 'Penulis', field: 'author', sort, dir }) %>
          <%- include('th', { label: 'Terbit', field: 'publishedAt', sort, dir }) %>
          <%- include('th', { label: 'Status', field: 'status', sort, dir }) %>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function (a) { %>
          <tr>
            <td><strong><%= a.title %></strong></td>
            <td><%= a.category %></td>
            <td><%= a.author %></td>
            <td><%= a.publishedAt ? formatDateShort(a.publishedAt) : '—' %></td>
            <td><span class="badge badge--<%= publicationStatusTone(a.status) %>"><%= publicationStatusLabel(a.status) %></span></td>
            <td>
              <div class="actions">
                <% if (a.status === 'published') { %>
                  <a href="/artikel/<%= a.slug %>" target="_blank" rel="noopener" class="btn-a btn-a--ghost btn-a--sm">Lihat</a>
                <% } %>
                <a href="/admin/artikel/<%= a.id %>/edit" class="btn-a btn-a--primary btn-a--sm">Edit</a>
                <form action="/admin/artikel/<%= a.id %>/hapus" method="post" onsubmit="return confirm('Hapus artikel <%= a.title %>?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-a btn-a--danger btn-a--sm">Hapus</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('pagination', { pg, q, status, sort, dir }) %>
