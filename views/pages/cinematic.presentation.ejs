<script>
  // Scroll-triggered reveal for cinematic presentation
  const revealEls = document.querySelectorAll('.section, .gallery-bento__item, .reorder-canvas__item');
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        revealObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach((el) => revealObserver.observe(el));

  // Watermark fade on scroll
  const presentWatermark = document.getElementById('presentWatermark');
  let lastY = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY || 0;
    if (y > lastY + 20) presentWatermark.classList.add('is-preview');
    else if (y < 80) presentWatermark.classList.remove('is-preview');
    lastY = y;
  }, { passive: true });
<\/script>