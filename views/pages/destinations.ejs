<section class="page-hero">
  <div class="container">
    <div class="breadcrumb"><a href="/">Beranda</a> / Destinasi</div>
    <h1>Destinasi Pulau</h1>
    <p>Enam gugusan kepulauan terbaik pilihan tim <%= brandName %> — dari barat sampai timur Indonesia.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <form class="search-bar" action="/destinasi" method="get">
      <input type="search" name="q" value="<%= q %>" placeholder="Cari destinasi, misal: Sabesi, Raja Ampat…">
      <button class="btn btn--deep btn--sm" type="submit">Cari</button>
    </form>

    <% if (destinations.length === 0) { %>
      <div class="empty-state">Destinasi tidak ditemukan. Coba kata kunci lain.</div>
    <% } else { %>

      <!-- Grid bento utama: item pertama = hero (span 2x2), sisanya = bento kecil -->
      <div class="gallery-bento">
        <% const featured = destinations.filter(d => d.featured); %>
        <% const others = destinations.filter(d => !d.featured); %>
        <!-- Hero bento: span 2x2 -->
        <% const hero = featured.length ? featured[0] : destinations[0]; %>
        <a href="/destinasi/<%= hero.slug %>" class="gallery-bento__item gallery-bento__item--span-2x2">
          <div class="gallery-bento__protection"></div>
          <div class="gallery-bento__canvas-wrap">
            <img src="<%= hero.image %>" alt="<%= hero.name %>" class="gallery-bento__img" loading="lazy">
          </div>
          <div class="gallery-bento__body">
            <span class="gallery-bento__eyebrow"><%= hero.region %></span>
            <h3><%= hero.name %></h3>
            <p><%= hero.tagline %></p>
            <div class="gallery-bento__meta">
              <span class="gallery-bento__price"><%= formatRupiah(hero.priceFrom) %> <small>mulai / orang</small></span>
              <span class="link-arrow">Lihat detail →</span>
            </div>
          </div>
        </a>

        <!-- Bento samping kanan: span 1x2 (dua baris) -->
        <% const rightCol = featured.slice(1, 3).concat(others).slice(0, 2); %>
        <% rightCol.forEach(function (d, idx) { %>
          <a href="/destinasi/<%= d.slug %>" class="gallery-bento__item gallery-bento__item--span-1x2">
            <div class="gallery-bento__protection"></div>
            <div class="gallery-bento__canvas-wrap">
              <img src="<%= d.image %>" alt="<%= d.name %>" class="gallery-bento__img" loading="lazy">
            </div>
            <div class="gallery-bento__body">
              <span class="gallery-bento__eyebrow"><%= d.region %></span>
              <h3><%= d.name %></h3>
              <p><%= d.tagline %></p>
              <div class="gallery-bento__meta">
                <span class="gallery-bento__price"><%= formatRupiah(d.priceFrom) %></span>
              </div>
            </div>
          </a>
        <% }); %>

        <!-- Baris bawah: tiga kartu 1x1 -->
        <% const bottomRow = others.slice(0, 3).concat(featured.slice(3)).slice(0, 3); %>
        <% bottomRow.forEach(function (d) { %>
          <a href="/destinasi/<%= d.slug %>" class="gallery-bento__item">
            <div class="gallery-bento__protection"></div>
            <div class="gallery-bento__canvas-wrap">
              <img src="<%= d.image %>" alt="<%= d.name %>" class="gallery-bento__img" loading="lazy">
            </div>
            <div class="gallery-bento__body">
              <span class="gallery-bento__eyebrow"><%= d.region %></span>
              <h3><%= d.name %></h3>
              <p><%= d.tagline %></p>
              <div class="gallery-bento__meta">
                <span class="gallery-bento__price"><%= formatRupiah(d.priceFrom) %> <small>mulai / orang</small></span>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<!-- Brand watermark (anchored to preview viewports) -->
<div class="brand-watermark" id="brandWatermark">
  <span class="brand-watermark__dots"></span>
  <span class="brand-watermark__text">seayoulatertrip</span>
</div>
<div class="watermark-sub">Seayoulatertrip · East Indonesia Expedition</div>
