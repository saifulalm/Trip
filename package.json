    "baileys": "^6.17.16",
    "qrcode": "^1.5.4"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.0.0",
    "express-session": "^1.18.1",
    "method-override": "^3.0.0",
    "multer": "^2.0.2"
  }
