  "description": "Website wisata pulau seayoulatertrip.com — public site + admin panel (Node.js + Express + EJS)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/seed.js",
    "seed:force": "node src/seed.js --force",
    "images": "node scripts/generate-images.js",
    "migrate:brand": "node scripts/migrate-brand.js",
    "migrate:brand:dry": "node scripts/migrate-brand.js --dry-run",
    "check": "node scripts/check-syntax.js",
    "test": "node scripts/test-splash.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "keywords": [
    "wisata",
