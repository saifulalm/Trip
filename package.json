{
  "name": "seayoulatertrip-website",
  "version": "1.0.0",
  "description": "Website wisata pulau seayoulatertrip.com — public site + admin panel (Node.js + Express + EJS)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/seed.js --force",
    "images": "node scripts/generate-images.js",
    "hero-media": "node scripts/generate-hero-media.js",
    "hero-scenes": "node -e \"require('./scripts/hero-scenes').forEach(s=>console.log(s.id,'|',s.name))\"",
    "test": "node scripts/wa-run-tests.js",
    "test:wa-gateway": "node scripts/wa-gateway.test.js",
    "test:openwa-webhook": "node scripts/verify-openwa-webhook.js",
    "check": "node scripts/wa-check.js",
    "test:e2e": "node scripts/run-e2e.js all",
    "test:e2e:wa": "node scripts/run-e2e.js wa-e2e",
    "test:e2e:portal": "node scripts/run-e2e.js portal",
    "test:portal-markup": "node scripts/run-e2e.js portal-markup",
    "test:portal-inline": "node scripts/run-e2e.js portal-inline",
    "test:portal-location": "node scripts/run-e2e.js portal-location",
    "test:admin-booking-detail": "node scripts/run-e2e.js admin-booking-detail",
    "test:admin-layout": "node scripts/run-e2e.js admin-layout",
    "test:admin-visual": "node scripts/run-e2e.js admin-visual",
    "test:admin-content": "node scripts/run-e2e.js admin-content",
    "test:admin-wa-settings": "node scripts/run-e2e.js admin-wa-settings",
    "test:e2e:redesign": "node scripts/run-e2e.js redesign-integration",
    "test:hero-mode": "node scripts/hero-mode.test.js",
    "test:admin-sprite": "node scripts/admin-sprite.test.js",
    "test:presence": "node scripts/presence.test.js",
    "test:presence-http": "node scripts/run-e2e.js presence",
    "test:social-unit": "node scripts/social-unit.test.js",
    "test:social-pages": "node scripts/run-e2e.js social-pages",
    "test:social-profiles": "node scripts/run-e2e.js social-profiles",
    "test:social-settings": "node scripts/run-e2e.js social-settings",
    "test:social-integration": "node scripts/run-e2e.js social-integration",
    "test:social-clear": "node scripts/run-e2e.js social-clear",
    "test:social-contrast": "node scripts/run-e2e.js social-contrast",
    "mock-postiz": "node scripts/mock-postiz.js",
    "cleanup:portal-testdata": "node scripts/cleanup-customer-testdata.js"
  },
  "keywords": [
    "wisata",
    "pulau",
    "travel",
    "express",
    "ejs"
  ],
  "author": "seayoulatertrip.com",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.0.0",
    "express-session": "^1.18.1",
    "method-override": "^3.0.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "puppeteer": "^24.38.0"
  }
}
