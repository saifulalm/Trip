# Salin file ini menjadi .env lalu sesuaikan kebutuhan
PORT=4100
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# Opsional: integrasi payment gateway (kosongkan untuk mode manual transfer saja)
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
# TRIPAY_MERCHANT_CODE=TRX-xxxx
# TRIPAY_PRIVATE_KEY=xxxx
# TRIPAY_API_KEY=xxxx

# Opsional: WhatsApp Cloud API (resmi Meta) untuk blast WhatsApp
# WA_TOKEN=EAAG...
# WA_PHONE_NUMBER_ID=123456789

# ---------------------------------------------------------------------------
# Reverse proxy (WAJIB diisi bila aplikasi diakses lewat nginx/Apache/Caddy)
# ---------------------------------------------------------------------------
# Tanpa ini, semua permintaan terlihat datang dari IP proxy sehingga rate
# limit login akan mengunci semua pengguna. Nilai = jumlah proxy tepercaya.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Lokasi data (opsional — default sudah benar, jangan diubah di produksi)
# ---------------------------------------------------------------------------
# Dipakai agar uji otomatis berjalan di folder terpisah dan tidak pernah
# menyentuh data asli. Lihat scripts/test-upload.js & scripts/test-admin.js.
# DB_FILE=./data/db.json
# UPLOAD_DIR=./public/uploads
# STATIC_DIR=./public

# ---------------------------------------------------------------------------
# Panduan konfigurasi AI Agent (Belum diimplementasikan — lihat README §11)
# ---------------------------------------------------------------------------
# Provider yang dipilih: Anthropic Claude (Messages API).
# Tidak perlu SDK — cukup fetch bawaan Node 18+.
# Ambil API key di https://console.anthropic.com/settings/keys
# JANGAN pernah menaruh kunci ini di dalam repo atau menyalinnya ke chat.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MAX_TOKENS=2048
# ANTHROPIC_TIMEOUT_MS=30000