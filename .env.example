# Salin file ini menjadi .env lalu sesuaikan kebutuhan
PORT=4100
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang

# Opsional: integrasi payment gateway (kosongkan untuk mode manual transfer saja)
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
# MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
# TRIPAY_MERCHANT_CODE=TRX-xxxx
# TRIPAY_PRIVATE_KEY=xxxx
# TRIPAY_API_KEY=xxxx

# Gateway WhatsApp OpenWA (self-hosted, REST API).
# Untuk KREDENSIAL di bawah, env MENANG atas nilai yang diisi di
# /admin/pengaturan → Gateway WhatsApp (kredensial最好不要 disimpan di db).
# OPENWA_BASE_URL=http://localhost:2785
# OPENWA_API_KEY=owa_k1_...
# OPENWA_SESSION_NAME=seayoulatertrip
# OPENWA_WEBHOOK_URL=https://domain-anda.com/api/webhooks/openwa
# OPENWA_WEBHOOK_SECRET=minimal-16-karakter-rahasia
# Batas waktu menunggu jawaban gateway (milidetik). Rentang valid: 3000–120000.
# Nilai di luar rentang dijepit ke batas terdekat. Default: 20000 (20 detik).
# CATATAN: untuk timeout, nilai di PANEL ADMIN yang menang. Env ini hanya
# dipakai sebagai cadangan bila key `openwaTimeoutMs` belum ada di database.
# OPENWA_TIMEOUT_MS=20000
